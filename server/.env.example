PORT=5000
NODE_ENV=development
# Local MongoDB (or paste your Atlas URI — use a database name, e.g. /complinova?retryWrites=true&w=majority)
MONGODB_URI=mongodb://127.0.0.1:27017/complinova
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Email (use Ethereal for dev: https://ethereal.email)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Quote values that contain spaces or angle brackets
EMAIL_FROM="CompliNova AI <noreply@complinova.ai>"

# OpenAI (optional — app uses smart fallbacks without key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cloudinary (optional — local disk used if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
